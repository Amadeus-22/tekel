# Copy to .env and adjust; `make run` loads it. See README "Configuration".
TICKGUARD_HTTP_ADDR=:8080
TICKGUARD_LOG_LEVEL=info
TICKGUARD_DATA_DIR=./data
TICKGUARD_DB_PATH=./tickguard.db

# Set a list to empty to disable that exchange.
TICKGUARD_BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
TICKGUARD_KRAKEN_SYMBOLS=BTC/USD,ETH/USD

TICKGUARD_CLOCK_SKEW=2s
TICKGUARD_OUT_OF_ORDER_TOLERANCE=0s
TICKGUARD_STALE_AFTER=60s
# Per-stream stale thresholds for quieter pairs: exchange:SYMBOL=duration,...
TICKGUARD_STALE_AFTER_OVERRIDES=kraken:ETH/USD=3m
TICKGUARD_DUPLICATE_WINDOW=10000
TICKGUARD_SPIKE_WINDOW=101
TICKGUARD_SPIKE_K=10
TICKGUARD_SPIKE_MIN_DEVIATION=0.005
TICKGUARD_BUFFER=4096
TICKGUARD_BAR_GRACE=2s
TICKGUARD_SHUTDOWN_TIMEOUT=10s
