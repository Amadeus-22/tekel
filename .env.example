# Copy to .env and adjust; `make run` loads it. See README "Configuration".
# 127.0.0.1 keeps the API local; use :8080 to listen on every interface.
TEKEL_HTTP_ADDR=127.0.0.1:8080
TEKEL_LOG_LEVEL=info
TEKEL_DATA_DIR=./data
TEKEL_DB_PATH=./tekel.db

# Set a list to empty to disable that exchange.
TEKEL_BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
TEKEL_KRAKEN_SYMBOLS=BTC/USD,ETH/USD
# Brazil, BASE-QUOTE spelling; off by default because LEAN needs a custom market.
TEKEL_MERCADOBITCOIN_SYMBOLS=
# KleverChain blocks: mainnet or testnet; off when empty. Mainnet also needs
# TEKEL_KLEVER_URL (the public mainnet node has no /subscribe).
TEKEL_KLEVER_NETWORK=
TEKEL_KLEVER_URL=

TEKEL_CLOCK_SKEW=2s
TEKEL_OUT_OF_ORDER_TOLERANCE=0s
TEKEL_STALE_AFTER=60s
# Per-stream stale thresholds for quieter pairs: exchange:SYMBOL=duration,...
TEKEL_STALE_AFTER_OVERRIDES=kraken:ETH/USD=3m
TEKEL_DUPLICATE_WINDOW=10000
TEKEL_SPIKE_WINDOW=101
TEKEL_SPIKE_K=10
TEKEL_SPIKE_MIN_DEVIATION=0.005
TEKEL_BUFFER=4096
TEKEL_BAR_GRACE=2s
TEKEL_SHUTDOWN_TIMEOUT=10s
