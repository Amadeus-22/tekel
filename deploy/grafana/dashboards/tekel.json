          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "Pipeline health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Tekel's own health, per 5 minutes. Every line should stay at 0; the area turns red above 0. Backpressure: seconds feeds waited because the pipeline was full. Sink errors: failed writes. Decode errors: malformed messages skipped. Late trades: trades that arrived after their minute bar was written.",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tekel_backpressure_seconds_total{exchange=~\"$exchange\"}[5m])) or vector(0)",
          "legendFormat": "Backpressure (s)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tekel_sink_errors_total[5m])) or vector(0)",
          "legendFormat": "Sink errors"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tekel_decode_errors_total{exchange=~\"$exchange\"}[5m])) or vector(0)",
          "legendFormat": "Decode errors"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tekel_late_trades_total{exchange=~\"$exchange\"}[5m])) or vector(0)",
          "legendFormat": "Late trades"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "softMax": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "links": [
            {
              "title": "What these numbers mean",
              "url": "https://github.com/Amadeus-22/tekel#http-api-and-metrics",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 110,
      "type": "text",
      "title": "About the sources",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 8
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;gap:12px;flex-wrap:wrap\"><div style=\"flex:1 1 230px;padding:14px 16px;border-radius:12px;border:1px solid rgba(127,127,127,.35);background:rgba(127,127,127,.07);text-align:left;border-top:3px solid #F0B90B\"><div style=\"font-size:18px;font-weight:700;margin-bottom:6px\">Binance</div><div style=\"font-size:14px;line-height:1.5;opacity:.9\">Founded in 2017. The largest crypto exchange by spot trading volume, with millions of trades a day across thousands of pairs.</div><div style=\"font-size:13px;margin-top:10px;opacity:.75\"><b>Tekel reads:</b> public trade stream <code>&lt;pair&gt;@trade</code>, sequential trade ID <code>t</code></div></div><div style=\"flex:1 1 230px;padding:14px 16px;border-radius:12px;border:1px solid rgba(127,127,127,.35);background:rgba(127,127,127,.07);text-align:left;border-top:3px solid #7B61FF\"><div style=\"font-size:18px;font-weight:700;margin-bottom:6px\">Kraken</div><div style=\"font-size:14px;line-height:1.5;opacity:.9\">Founded in 2011 in San Francisco, one of the oldest crypto exchanges still operating. Known for spot, futures and its WebSocket v2 API.</div><div style=\"font-size:13px;margin-top:10px;opacity:.75\"><b>Tekel reads:</b> WebSocket v2 <code>trade</code> channel, <code>trade_id</code> per book</div></div><div style=\"flex:1 1 230px;padding:14px 16px;border-radius:12px;border:1px solid rgba(127,127,127,.35);background:rgba(127,127,127,.07);text-align:left;border-top:3px solid #0052FF\"><div style=\"font-size:18px;font-weight:700;margin-bottom:6px\">Coinbase</div><div style=\"font-size:14px;line-height:1.5;opacity:.9\">Founded in 2012 in San Francisco. Listed on Nasdaq (COIN) since 2021, the largest US-based crypto exchange.</div><div style=\"font-size:13px;margin-top:10px;opacity:.75\"><b>Tekel reads:</b> Exchange feed <code>matches</code> channel, <code>trade_id</code>, plus the 1 s <code>heartbeat</code></div></div><div style=\"flex:1 1 230px;padding:14px 16px;border-radius:12px;border:1px solid rgba(127,127,127,.35);background:rgba(127,127,127,.07);text-align:left;border-top:3px solid #AA33B5\"><div style=\"font-size:18px;font-weight:700;margin-bottom:6px\">KleverChain</div><div style=\"font-size:14px;line-height:1.5;opacity:.9\">Klever's layer-1 blockchain, built for fast and low-cost payments and tokens. Mainnet since July 1, 2022, with a new block every 4 seconds.</div><div style=\"font-size:13px;margin-top:10px;opacity:.75\"><b>Tekel reads:</b> the node's <code>/subscribe</code> WebSocket, <code>blocks</code>, block <code>nonce</code> and <code>txCount</code></div></div></div>"
      },
      "transparent": false
    }
  ],
  "templating": {
