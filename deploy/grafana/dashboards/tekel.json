              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
