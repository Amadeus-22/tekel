    {
      "id": 3,
      "type": "timeseries",
      "title": "Receive lag p99",
      "description": "Received time minus exchange (or block) time, 99th percentile over 5 minutes (tekel_feed_lag_seconds). Exchanges that stamp whole seconds read up to 1 s high.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 17,
        "y": 30,
        "w": 7,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (exchange, symbol, le) (rate(tekel_feed_lag_seconds_bucket{exchange=~\"$exchange\"}[5m])))",
          "legendFormat": "{{exchange}} {{symbol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Incidents per 5 min",
      "description": "New data-quality incidents in each 5-minute window, including the first incident of a stream (tekel_incidents_total). Details: GET /v1/incidents.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum by (exchange, symbol, kind) (tekel_incidents_total{exchange=~\"$exchange\",kind=~\"$kind\"}) - sum by (exchange, symbol, kind) (tekel_incidents_total{exchange=~\"$exchange\",kind=~\"$kind\"} offset 5m), 0) or sum by (exchange, symbol, kind) (tekel_incidents_total{exchange=~\"$exchange\",kind=~\"$kind\"} unless tekel_incidents_total{exchange=~\"$exchange\",kind=~\"$kind\"} offset 5m)",
