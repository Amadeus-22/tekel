    {
      "id": 9,
      "type": "timeseries",
      "title": "KleverChain blocks and transactions",
      "description": "Blocks per second (tekel_blocks_total; one block every ~4 s on mainnet) and transactions per second, from each block's txCount (tekel_block_transactions_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 11,
        "y": 30,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (chain, network) (rate(tekel_blocks_total{chain=~\"$exchange\"}[1m]))",
          "legendFormat": "blocks/s {{chain}} {{network}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (chain, network) (rate(tekel_block_transactions_total{chain=~\"$exchange\"}[1m]))",
          "legendFormat": "txs/s {{chain}} {{network}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
