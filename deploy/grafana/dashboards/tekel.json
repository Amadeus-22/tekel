{
  "uid": "tekel",
  "title": "Tekel",
  "tags": [
    "tekel"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "description": "Live data quality of public crypto feeds (Binance, Kraken, KleverChain), checked against CoinMarketCap. Source: github.com/Amadeus-22/tekel",
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;width:100%;padding-top:4px\">\n<img src=\"https://raw.githubusercontent.com/Amadeus-22/tekel/main/docs/assets/logo.png\" alt=\"Tekel\" width=\"76\" height=\"76\" style=\"display:block;margin:0 auto;border-radius:16px\">\n<div style=\"font-size:34px;font-weight:700;line-height:1.1;letter-spacing:.5px\">Tekel</div>\n<div style=\"font-size:17px;opacity:.8\">Live market data quality, checked every second</div>\n<div style=\"font-size:15px;line-height:1.5;margin-top:4px\">\n<span style=\"display:inline-block;padding:7px 14px;border-radius:999px;border:1px solid rgba(127,127,127,.4);background:rgba(127,127,127,.10);margin:0 4px 8px 4px\"><b>Exchanges</b> · Binance, Kraken, Coinbase: every trade ID checked for gaps, duplicates and delays; prices compared with CoinMarketCap</span>\n<span style=\"display:inline-block;padding:7px 14px;border-radius:999px;border:1px solid rgba(127,127,127,.4);background:rgba(127,127,127,.10);margin:0 4px 8px 4px\"><b>KleverChain</b> · every block event checked for missed nonces</span>\n</div>\n<div style=\"font-size:14px;opacity:.75\">Click any tile or legend to filter the dashboard. Hover a chart for exact values.</div>\n<a href=\"https://github.com/Amadeus-22/tekel\" target=\"_blank\" style=\"font-size:15px;padding:7px 16px;border-radius:10px;border:1px solid rgba(127,127,127,.45);text-decoration:none\">Open source · GitHub →</a>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Uptime in range",
      "description": "Share of the selected time range each source was connected. The line inside each tile shows connection over time. Click a tile to filter the dashboard to that source.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (exchange) (avg_over_time(tekel_connected{exchange=~\"$exchange\"}[$__rate_interval]))",
          "legendFormat": "{{exchange}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Incidents in range",
      "description": "Incidents in the selected range, by kind. sequence_gap: an ID jumped while connected. duplicate / out_of_order: same or older ID again. clock_skew: a trade or block arrived more than 2 s from its source timestamp (on Coinbase this is delivery delay). stale_stream: no data for too long. disconnect: the connection dropped. Click a tile to filter by kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (increase(tekel_incidents_total{exchange=~\"$exchange\",kind=~\"$kind\"}[$__range]))",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "links": [
            {
              "title": "Show only ${__field.labels.kind} incidents",
              "url": "/d/${__dashboard.uid}?var-kind=${__field.labels.kind}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Worst CMC deviation",
      "description": "Largest distance between a source's last trade and CoinMarketCap in the range. Click a tile to filter to that source.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 10,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (exchange) (max_over_time(abs(tekel_reference_deviation_ratio{exchange=~\"$exchange\"})[$__range:]))",
          "legendFormat": "{{exchange}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "CMC checks and credits",
      "description": "Reference price requests to CoinMarketCap in the range, by outcome, and the API key's credits this month as CoinMarketCap reports them (/v1/key/info, which costs no credits).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 10,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(tekel_reference_fetches_total[$__range]))",
          "legendFormat": "checks {{outcome}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (kind) (tekel_reference_credits{kind=~\"used_month|left_month\"})",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "CMC deviation, by stream",
      "description": "Last trade minus CoinMarketCap's price, divided by that price (0.01 = 1% above). Dashed lines: the 1% price_deviation threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tekel_reference_deviation_ratio{exchange=~\"$exchange\"}",
          "legendFormat": "{{exchange}} {{symbol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": -0.01
              },
              {
                "color": "transparent",
                "value": -0.00999
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 106,
      "type": "bargauge",
      "title": "Incidents by stream",
      "description": "Incidents per stream and kind in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (exchange, symbol, kind) (increase(tekel_incidents_total{exchange=~\"$exchange\",kind=~\"$kind\"}[$__range])) > 0)",
          "legendFormat": "{{exchange}} {{symbol}} {{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "continuous-YlRd"
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Show only ${__field.labels.kind} incidents",
              "url": "/d/${__dashboard.uid}?var-kind=${__field.labels.kind}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "namePlacement": "top",
        "sizing": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 12
        },
        "valueMode": "color"
      }
    },
    {
      "id": 107,
      "type": "bargauge",
      "title": "CMC agreement (≤ 0.1%)",
      "description": "Share of CoinMarketCap checks in the range where the stream's last trade was within 0.1% of CoinMarketCap's price (tekel_reference_distance_ratio). Higher is better.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (exchange, symbol) (increase(tekel_reference_distance_ratio_bucket{exchange=~\"$exchange\",le=\"0.001\"}[$__range])) / sum by (exchange, symbol) (increase(tekel_reference_distance_ratio_count{exchange=~\"$exchange\"}[$__range])))",
          "legendFormat": "{{exchange}} {{symbol}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "namePlacement": "top",
        "sizing": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 12
        },
        "valueMode": "color"
      }
    },
    {
      "id": 108,
      "type": "table",
      "title": "CMC agreement bands",
      "description": "Share of CoinMarketCap checks in the range within 0.1%, 0.25% and 0.5% of CoinMarketCap's price, all symbols of the exchange together.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 23,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exchange) (increase(tekel_reference_distance_ratio_bucket{exchange=~\"$exchange\",le=\"0.001\"}[$__range])) / sum by (exchange) (increase(tekel_reference_distance_ratio_count{exchange=~\"$exchange\"}[$__range]))",
          "legendFormat": "{{exchange}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exchange) (increase(tekel_reference_distance_ratio_bucket{exchange=~\"$exchange\",le=\"0.0025\"}[$__range])) / sum by (exchange) (increase(tekel_reference_distance_ratio_count{exchange=~\"$exchange\"}[$__range]))",
          "legendFormat": "{{exchange}}",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exchange) (increase(tekel_reference_distance_ratio_bucket{exchange=~\"$exchange\",le=\"0.005\"}[$__range])) / sum by (exchange) (increase(tekel_reference_distance_ratio_count{exchange=~\"$exchange\"}[$__range]))",
          "legendFormat": "{{exchange}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "exchange": "Exchange",
              "Value #A": "≤ 0.1%",
              "Value #B": "≤ 0.25%",
              "Value #C": "≤ 0.5%"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Exchange"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Connection",
      "description": "1 while the feed is connected and subscribed (tekel_connected).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (exchange) (tekel_connected{exchange=~\"$exchange\"})",
          "legendFormat": "{{exchange}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "horizontal",
        "text": {
          "titleSize": 12,
          "valueSize": 18
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Trades per second (exchanges)",
      "description": "Trades received per second per exchange pair (tekel_trades_total). Exchanges have no blocks: each trade carries the exchange's own sequential trade ID.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 30,
        "w": 7,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exchange, symbol) (rate(tekel_trades_total{exchange=~\"$exchange\"}[1m]))",
          "legendFormat": "{{exchange}} {{symbol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "Show only ${__field.labels.exchange}",
              "url": "/d/${__dashboard.uid}?var-exchange=${__field.labels.exchange}&${__url_time_range}"
            },
            {
              "title": "Reset filters",
              "url": "/d/${__dashboard.uid}?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
